# ==============================================================================
# NEXGILE-TRAVAI: ENTERPRISE ENVIRONMENT CONFIGURATION TEMPLATE
# Do NOT commit actual secrets to this file. Use .env for local runtime.
# ==============================================================================

# Application & Environment
PROJECT_NAME="Nexgile-TravAI"
VERSION="1.0.0"
ENVIRONMENT="development"
DEBUG=true

# Server Binding
HOST="0.0.0.0"
PORT=8000
API_V1_STR="/api/v1"

# Security & Tokens (Change in production!)
SECRET_KEY="generate_a_secure_random_32_character_hex_string_here"
ALGORITHM="HS256"
ACCESS_TOKEN_EXPIRE_MINUTES=60
REFRESH_TOKEN_EXPIRE_DAYS=7

# CORS Allowed Origins (Comma separated or JSON array)
CORS_ORIGINS="http://localhost:3000,http://localhost:5173,http://127.0.0.1:3000"

# PostgreSQL Database (Authoritative Single Source of Truth)
DATABASE_URL="postgresql+asyncpg://postgres:postgres@localhost:5432/nexgile_travai"
DB_POOL_SIZE=20
DB_MAX_OVERFLOW=10
DB_POOL_TIMEOUT=30
DB_POOL_RECYCLE=1800

# Auxiliary Redis Cache (Optional - Never Authoritative for Inventory)
REDIS_ENABLED=false
REDIS_URL="redis://localhost:6379/0"

# Google Gemini API (Server-Side Only - Never Expose to Frontend)
GEMINI_API_KEY=""
GEMINI_MODEL_ID="gemini-2.5-flash"

# System Governance Defaults
IDEMPOTENCY_EXPIRE_HOURS=48
OUTBOX_MAX_RETRIES=5
OUTBOX_BATCH_SIZE=100
